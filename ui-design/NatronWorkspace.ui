  <property name="styleSheet"><string notr="true">QWidget { color: #c7c7c7; background-color: #303030; font-family: "Droid Sans"; font-size: 11pt; }
QSplitter { background-color: #1f1f1f; }
QSplitter::handle { background-color: #1f1f1f; }
QTabWidget::pane { border: 1px solid #1f1f1f; background-color: #303030; }
QTabBar::tab { background-color: #303030; color: #c7c7c7; border: 1px solid #1f1f1f; padding: 5px 12px; }
QTabBar::tab:selected { background-color: #474747; border-bottom: 2px solid #f28a00; }
QTabBar::tab:hover { background-color: #474747; }
QToolButton { background-color: #303030; border: 1px solid transparent; padding: 2px; }
QToolButton:hover { background-color: #474747; border: 1px solid #666666; }
QToolButton:pressed { background-color: #1f1f1f; }
QWidget#toolBox QToolButton { min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px; }
QWidget#viewerPage QToolButton { min-width: 22px; max-width: 22px; min-height: 22px; max-height: 22px; }
QFrame#viewerCanvas { background-color: #111111; border: 1px solid #1f1f1f; }
QLabel#viewerCanvasLabel { background-color: #111111; color: #777777; }
QLabel#nodeGraphLabel { color: #777777; }
QSlider::groove:horizontal { height: 5px; background-color: #1f1f1f; }
QSlider::handle:horizontal { width: 10px; margin: -5px 0; background-color: #f28a00; border-radius: 3px; }</string></property>
